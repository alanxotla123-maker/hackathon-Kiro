# ============================================
# GitHub OAuth 2.0 Configuration
# ============================================
# Copia este archivo como .env y reemplaza los valores placeholder
# con las credenciales reales de tu GitHub OAuth App.
#
# Para crear una GitHub OAuth App:
#   1. Ve a https://github.com/settings/developers
#   2. Click "New OAuth App"
#   3. Completa los campos requeridos
#   4. Copia el Client ID y genera un Client Secret
# ============================================

# Client ID de tu GitHub OAuth App (público, se usa en el frontend)
VITE_GITHUB_CLIENT_ID=[TU_CLIENT_ID_AQUÍ]

# URL de callback a la que GitHub redirigirá después de la autorización
# Debe coincidir EXACTAMENTE con la configurada en tu GitHub OAuth App
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/api/auth/github/callback

# --------------------------------------------------
# Las siguientes variables son para el BACKEND (Fase 2)
# NO las expongas en el frontend
# --------------------------------------------------

# Client Secret de tu GitHub OAuth App (NUNCA exponer en el frontend)
# GITHUB_CLIENT_SECRET=[TU_CLIENT_SECRET_AQUÍ]

# ============================================
# Google OAuth 2.0 Configuration
# ============================================
# Client ID de tu Google OAuth App (público, se usa en el frontend)
VITE_GOOGLE_CLIENT_ID=[TU_GOOGLE_CLIENT_ID_AQUÍ]

# URL de callback a la que Google redirigirá después de la autorización
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# --------------------------------------------------
# Variables para el BACKEND (Fase 2)
# --------------------------------------------------
# GOOGLE_CLIENT_SECRET=[TU_GOOGLE_CLIENT_SECRET_AQUÍ]
